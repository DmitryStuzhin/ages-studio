# База. Без DATABASE_URL используется встроенный PostgreSQL (PGlite) в .data/
# DATABASE_URL=postgres://user:pass@localhost:5432/ages

# Claude API — кнопка «Сгенерировать» в шагах
# ANTHROPIC_API_KEY=

# YouTube Data API — сводка ниши
# YOUTUBE_API_KEY=

# YouTube Analytics API (OAuth). Приложение Google держи в режиме «In production»,
# иначе refresh-токен перестаёт работать через 7 дней.
# Redirect URI в Google Cloud: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # только если платформа открывается не на localhost:3000

# ElevenLabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Google Drive: папка с кадрами
# GOOGLE_DRIVE_FOLDER_ID=
